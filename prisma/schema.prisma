generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  ticker      String?
  secCik      String?  @map("sec_cik")
  website     String
  linkedinUrl String?  @map("linkedin_url")
  irPageUrl   String?  @map("ir_page_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  signals        Signal[]
  contacts       Contact[]
  revenueRecords RevenueRecord[]

  @@map("companies")
}

model Signal {
  id               String   @id @default(cuid())
  companyId        String   @map("company_id")
  signalType       String   @map("signal_type") // ai_investment | ai_adoption | exec_hire | partnership | product_launch | other
  summary          String
  aiRelevanceScore Float    @map("ai_relevance_score")
  lowRelevance     Boolean  @default(false) @map("low_relevance")
  publishedDate    DateTime? @map("published_date")
  sourceUrl        String   @map("source_url")
  createdAt        DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("signals")
}

model Contact {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  name        String?
  title       String?
  region      String?  // APAC | EMEA | Americas | Japan
  linkedinUrl String?  @map("linkedin_url")
  email       String?
  sourceUrl   String   @map("source_url")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("contacts")
}

model RevenueRecord {
  id               String  @id @default(cuid())
  companyId        String  @map("company_id")
  year             Int
  revenue          Float?  // in millions, native currency
  currency         String? // USD, EUR, JPY, etc.
  revenueGrowthPct Float?  @map("revenue_growth_pct")
  segment          String? // Total, Beauty Division, Skincare, etc.
  sourceUrl        String  @map("source_url")
  createdAt        DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("revenue_records")
}

model FailedUrl {
  id        String   @id @default(cuid())
  url       String
  reason    String
  context   String?  // e.g. "signal", "contact", "revenue"
  createdAt DateTime @default(now()) @map("created_at")

  @@map("failed_urls")
}
